# Copy to .env.local (git-ignored). Every value is OPTIONAL: with no env at all
# the app runs on an in-memory mock database seeded with fake data.

# Persist data in MongoDB (required for a multi-instance serverless deployment,
# e.g. Vercel + MongoDB Atlas, because in-memory state is per-instance).
# MONGODB_URI=
# MONGODB_DB=digital_hr

# If set, the login form also asks for this shared demo password.
# Leave unset for passwordless "mock SSO" sign-in with the demo personas.
# DEMO_PASSWORD=

# Optional. When all three are set, Al Jana asks the model only for a knowledge-base
# article id. The answer text still comes from the knowledge base. If any value is
# missing, or the call fails, the built-in search is used.
# ASSISTANT_MODEL_BASE_URL=
# ASSISTANT_MODEL_KEY=
# ASSISTANT_MODEL_NAME=
